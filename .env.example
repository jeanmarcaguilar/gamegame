# EmailJS configuration (https://www.emailjs.com/)
# Without these the contact form will still work — payload is logged to console only.

VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# Spotify Now Playing widget
# 1) Create an app at https://developer.spotify.com/dashboard
# 2) Add redirect URI: http://localhost:5173/spotify-auth.html (and your production URL)
# 3) Update CLIENT_ID in spotify-auth.html with your actual Client ID
# 4) Open http://localhost:5173/spotify-auth.html in your browser once to get the refresh token
# 5) Copy the refresh token and paste it below
# Scopes used: user-read-currently-playing, user-read-recently-played, user-read-playback-state
VITE_SPOTIFY_CLIENT_ID=your_spotify_client_id
VITE_SPOTIFY_REFRESH_TOKEN=your_spotify_refresh_token
